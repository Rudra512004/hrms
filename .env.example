# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Core Django Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=<SECRET_KEY>

# Domain & CORS Restrictions
DJANGO_ALLOWED_HOSTS=<BACKEND_DOMAIN>
DJANGO_CORS_ALLOWED_ORIGINS=<FRONTEND_URL>
DJANGO_CSRF_TRUSTED_ORIGINS=<FRONTEND_URL>

# Database (PostgreSQL)
DATABASE_URL=<POSTGRES_CONNECTION_STRING>

# Frontend Configuration
FRONTEND_URL=<FRONTEND_BASE_URL>
VITE_API_BASE_URL=<BACKEND_API_BASE_URL>

# Email Configuration (SMTP)
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<SMTP_USERNAME>
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
DEFAULT_FROM_EMAIL=<SMTP_FROM_EMAIL>

# Object Storage (AWS S3)
AWS_ACCESS_KEY_ID=<AWS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET>
AWS_STORAGE_BUCKET_NAME=<S3_BUCKET_NAME>
AWS_S3_REGION_NAME=<AWS_REGION>
